<div class="form-container">
  <h2>アカウント編集</h2>

  <%= form_for(
        resource,
        as: resource_name,
        url: registration_path(resource_name),
        html: { method: :put }
      ) do |f| %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="detail-item">
      <p>
        <%= f.label :name, "名前" %>
      </p>

      <p>
        <%= f.text_field :name, autofocus: true %>
      </p>
    </div>

    <div class="detail-item">
      <p>
        <%= f.label :profile, "自己紹介" %>
      </p>

      <p>
        <%= f.text_area :profile, autofocus: true %>
      </p>
    </div>

    <div class="detail-item">
      <p>
        <%= f.label :email, "メールアドレス" %>
      </p>

      <p>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email" %>
      </p>
    </div>

    <div class="detail-item">
      <p>
        <%= f.label :password, "パスワード" %>
        (変更したくない場合は空欄のままにしてください)
      </p>

      <p>
        <%= f.password_field :password,
              autocomplete: "new-password" %>
      </p>

      <% if @minimum_password_length %>
        <p>
          <em>
            <%= @minimum_password_length %> 文字以上で入力してください
          </em>
        </p>
      <% end %>
    </div>

    <div class="detail-item">
      <p>
        <%= f.label :password_confirmation, "パスワード確認" %>
      </p>

      <p>
        <%= f.password_field :password_confirmation,
              autocomplete: "new-password" %>
      </p>
    </div>

    <div class="detail-item">
      <p>
        <%= f.label :current_password, "現在のパスワード" %>
        (本人確認のため入力してください)
      </p>

      <p>
        <%= f.password_field :current_password,
              autocomplete: "current-password" %>
      </p>
    </div>

    <div class="actions">
      <%= f.submit "更新する" %>
    </div>
  <% end %>

  <div class="actions">
    <p>退会する場合はこちら</p>

    <%= button_to "アカウントを削除する",
          registration_path(resource_name),
          data: {
            confirm: "本当に削除しますか?",
            turbo_confirm: "本当に削除しますか?"
          },
          method: :delete %>
  </div>

  <div class="actions">
    <%= link_to "マイページへ戻る", user_path(current_user) %>
  </div>
</div>
