<h2>投稿一覧</h2>

<p>
  <%= form_tag study_logs_path, method: :get do %>
    <%= select_tag :category_id,
        options_from_collection_for_select(Category.all, :id, :name, params[:category_id]),
        prompt: "カテゴリで絞る" %>

    <%= text_field_tag :keyword, params[:keyword], placeholder: "キーワードで検索" %>

    <%= submit_tag "検索" %>
  <% end %>
</p>

<% @study_logs.each do |study_log| %>
  <p>
    タイトル：<%= link_to study_log.title, study_log %>
  </p>

  <p>
    学習内容：<%= study_log.content %>
  </p>

  <p>
    学習時間：<%= study_log.study_time %>分
  </p>

  <p>
    学習日：<%= study_log.study_date %>
  </p>

  <p>
    種類：<%= study_log.category&.name || "未設定" %>
  </p>

  <div>
    <%= render "favorite", study_log: study_log %>
  </div>
<% end %>

<div>
  <%= link_to "新規登録", new_study_log_path %>
</div>
