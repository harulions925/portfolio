<% if user_signed_in? %>
  <% if study_log.favorited_by?(current_user) %>
    <%= button_to "お気に入り解除",
        study_log_favorite_path(study_log),
        method: :delete %>
  <% else %>
    <%= button_to "お気に入り",
        study_log_favorite_path(study_log),
        method: :post %>
  <% end %>

  <p>
    お気に入り数：<%= study_log.favorites.count %>
  </p>
<% end %>