<h2>投稿詳細</h2>
  <div>
    <p>タイトル</p>
    <p><%= @study_log.title %></p>
  </div>

  <div>
    <p>学習内容</p>
    <p><%= @study_log.content %></p>
  </div>

  <div>
    <p>学習時間</p>
    <p><%= @study_log.study_time %></p>
  </div>

  <div>
    <p>学習日</p>
    <p><%= @study_log.study_date %></p>
  </div>

  <div>
    <%= link_to "一覧に戻る", study_logs_path %>
  </div>

  <% if user_signed_in? && @study_log.user_id == current_user.id %>
    <div>
      <%= link_to "情報を編集する",
            edit_study_log_path(@study_log) %>
    </div>
    <div>
      <%= link_to "削除",
            study_log_path, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか?" } %>
    </div>

  <% end %>
  